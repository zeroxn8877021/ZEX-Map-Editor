; Engine configuration file.
config_version=5

[application]
config/name="ZEX Map Editor"
config/description="Touch-first Surveyor-style map editor (sculpt, paint, objects, scatter, water, roads/rails/rivers, GLB export)"
run/main_scene="res://scenes/editor.tscn"
config/features=PackedStringArray("4.3", "Mobile")
run/max_fps=60

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
scaling_3d/mode=0
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.85, 1)
